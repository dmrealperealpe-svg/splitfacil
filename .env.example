# Copia este archivo como ".env" y ajusta los valores. El archivo .env NUNCA se sube a GitHub.
# (Tema 5 y 7: los secretos viven en variables de entorno, no en el código.)

# development = tu computador | production = servidor real
APP_ENV=development

# Clave que firma las sesiones. En producción es OBLIGATORIA (mínimo 24 caracteres).
# Genera una así:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta

# Administrador inicial: se crea solo al arrancar si no existe.
ADMIN_EMAIL=admin@splitfacil.local
ADMIN_PASSWORD=Admin12345
ADMIN_NOMBRE=Administrador

# Base de datos. Vacío = SQLite local (instance/splitfacil.db), no hay que instalar nada.
# Para PostgreSQL/Supabase: postgresql://usuario:clave@servidor:5432/basedatos
DATABASE_URL=

# Solo producción (detrás de HTTPS)
# COOKIE_SEGURA=1
# CONFIAR_PROXY=1

# Correo para recuperar contraseñas (opcional; sin esto, en desarrollo el enlace se muestra en pantalla)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=tu_correo@gmail.com
# MAIL_PASSWORD=clave-de-aplicacion
# MAIL_FROM=SplitFácil <tu_correo@gmail.com>
